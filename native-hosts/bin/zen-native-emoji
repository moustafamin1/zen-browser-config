#!/usr/bin/env python3
import sys
import struct
import subprocess
import time

def trigger_emoji():
    # Brief pause to allow context menu to dismiss and input field to regain active focus
    time.sleep(0.08)
    
    # Method 1: Tell macOS System Events to click the native menu item in Zen
    apple_script_menu = '''
    tell application "System Events"
        tell process "Zen"
            try
                click menu item "Emoji & Symbols" of menu "Edit" of menu bar 1
            on error
                keystroke " " using {control down, command down}
            end try
        end tell
    end tell
    '''
    subprocess.run(["osascript", "-e", apple_script_menu], capture_output=True)

def main():
    try:
        # Read 4-byte message length
        raw_length = sys.stdin.buffer.read(4)
        if raw_length:
            msg_len = struct.unpack("@I", raw_length)[0]
            sys.stdin.buffer.read(msg_len)
    except Exception:
        pass

    trigger_emoji()

    try:
        resp = b'{"status":"ok"}'
        sys.stdout.buffer.write(struct.pack("@I", len(resp)))
        sys.stdout.buffer.write(resp)
        sys.stdout.buffer.flush()
    except Exception:
        pass

if __name__ == "__main__":
    main()
